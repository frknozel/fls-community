[Unit]
Description=FLS verified copy of closed detailed logs and isolated restore validation
After=mariadb.service
Requires=mariadb.service
RequiresMountsFor=/srv/fls-server/raw /srv/fls-server/archive/detailed

[Service]
Type=oneshot
User=fls-cold
Group=fls-cold
SupplementaryGroups=adm
LoadCredential=database:/etc/fls/cold-storage.json
LoadCredential=signing-key:/etc/fls/cold-signing-key.pem
LoadCredential=raw-public-key:/var/www/fls/public/archive-public-key.pem
LoadCredential=instance:/etc/fls/instance.json
ExecStart=/usr/bin/python3 /var/www/fls/bin/cold-storage.py
RuntimeDirectory=fls-cold-storage
UMask=0027
Nice=15
IOSchedulingClass=idle
CPUWeight=5
IOWeight=5
CPUQuota=40%
MemoryMax=384M
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/srv/fls-server/raw /srv/fls-server/archive/manifests /srv/fls-server/archive/packages
ReadWritePaths=/srv/fls-server/archive/detailed /run/fls-cold-storage
InaccessiblePaths=/etc/fls /srv/fls-server/queue /srv/fls-server/backups /var/log -/var/lib/fls -/var/cache/fls -/srv/fls-server/database /srv/fls-server/metrics

