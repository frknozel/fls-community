[Unit]
Description=FLS RAM disk queue and archive telemetry
RequiresMountsFor=/srv/fortigate
After=fortigate-collector.service
After=mariadb.service

[Service]
Type=oneshot
User=syslog
Group=adm
RuntimeDirectory=fls-telemetry
RuntimeDirectoryPreserve=yes
LoadCredential=database:/etc/fls/telemetry.json
LoadCredential=history-database:/etc/fls/backlog-history.json
ExecStart=/usr/bin/python3 /var/www/fls/bin/telemetry-with-history.py
UMask=0027
TimeoutStartSec=20
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/fortigate/metrics/telemetry /run/fls-telemetry

