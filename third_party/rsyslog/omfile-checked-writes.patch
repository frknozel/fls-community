--- a/runtime/stream.c
+++ b/runtime/stream.c
@@ -95,6 +95,55 @@
 
 /* methods */
 
+/* Reliable collector streams must not return an append/sync failure to a caller
+ * which might release the message or replay an already-written prefix. Keep the
+ * operation and its byte offset on this stack instead. SIGTERM deliberately does
+ * not turn an outstanding write into success; repair storage before stopping.
+ * Unexpected descriptor/argument errors fail closed instead of spinning forever.
+ */
+void
+strmReliableRetry(const uchar *path, const char *operation, const int err, unsigned *attempts)
+{
+	if(err == 0) {
+		if(*attempts != 0)
+			LogMsg(0, RS_RET_OK, LOG_INFO, "FLS reliable storage recovered: %s '%s'", operation, path);
+		*attempts = 0;
+		return;
+	}
+	if(err == EINTR)
+		return;
+	if(err != ENOSPC && err != EDQUOT && err != EIO && err != EROFS &&
+	   err != ENOENT && err != EACCES && err != EPERM) {
+		LogError(err, RS_RET_IO_ERROR, "FLS reliable storage fatal: %s '%s'; collector stopping", operation, path);
+		/* Do not produce a core containing source records. */
+		_exit(EXIT_FAILURE);
+	}
+	if((*attempts)++ % 60 == 0)
+		LogError(err, RS_RET_IO_ERROR, "FLS reliable storage blocked: %s '%s'; "
+			"retaining pending data and applying backpressure; restore storage before stopping", operation, path);
+	srSleep(1, 0);
+}
+
+void
+strmReliableSyncDirectory(const uchar *path)
+{
+	int directory, synced;
+	unsigned attempts = 0;
+	do {
+		directory = open((char*)path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+		if(directory == -1)
+			strmReliableRetry(path, "open sync directory", errno, &attempts);
+	} while(directory == -1);
+	strmReliableRetry(path, "open sync directory", 0, &attempts);
+	do {
+		synced = fsync(directory);
+		if(synced != 0)
+			strmReliableRetry(path, "directory sync", errno, &attempts);
+	} while(synced != 0);
+	strmReliableRetry(path, "directory sync", 0, &attempts);
+	close(directory);
+}
